{
  "framework": null,
  "buildCommand": "npx prisma generate",
  "installCommand": "cd .. && npm install",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10,
      "includeFiles": "../node_modules/.prisma/client/**"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/[...slug]" }]
}
